# Everything the bot learns is local and private until it is explicitly exported.
# data/ in particular holds consent.json and the raw Discord ids it is keyed by,
# and .salt, which is what makes the published hashes unlinkable. Never commit it.
data/
checkpoints/
export/
logs/
external/
.scratch/
artifacts/

# Corpus-derived artifacts fall under the same rule as data/: model weights
# at this scale memorize rows outright, and a recombined synthetic row is a
# verbatim splice of real corpus phrasing. Neither is ever committed. The
# loss curves and logs under experiments/ (numbers only) carry the evidence;
# experiments/gen_synth_corpora.py regenerates the experiment corpora on
# demand from the local data/.
*.pt
experiments/synthetic_corpus_*.jsonl

.env
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
runs/
.env.sft
