# boopit -- the comparison bot, served side by side with booper.
#
# Copy to ~/babble-boopit/.env, put the boopit Discord token in, and adjust
# the /home/YOU paths. systemd's EnvironmentFile does no variable expansion,
# so every path must be absolute. Everything boopit-specific lives under
# ~/babble-boopit so it can never touch booper's data, salt, or checkpoints
# in ~/babble-live; the code and venv are shared from ~/babble-live.

# boopit's own bot token -- never booper's. One token, one process.
BABBLE_DISCORD_TOKEN=PUT_BOOPIT_TOKEN_HERE

BABBLE_DATA_DIR=/home/YOU/babble-boopit/data
BABBLE_CHECKPOINT_DIR=/home/YOU/babble-boopit/checkpoints
BABBLE_EXPORT_DIR=/home/YOU/babble-boopit/export
BABBLE_LOG_DIR=/home/YOU/babble-boopit/logs

# Decode layout -- MUST match how boopit-1 was trained; the checkpoint file
# carries no flag and nothing auto-detects this (same invariant as booper).
#   pair         = <bos> prompt <sep> response <eos>  (chat/SFT checkpoints)
#   continuation = plain language-model continuation  (pretrain checkpoints)
# Check the ProCreations/boopit-1 model card before starting the bot.
BABBLE_SERVE_LAYOUT=pair
BABBLE_POST_LAYOUT=pair

# Serve-only: the corpus-growth triggers would overwrite the promoted
# checkpoint with a from-scratch model (same incident booper's .env guards
# against). Manual training only.
BABBLE_TRAIN_TRIGGER_ROWS=0
BABBLE_POST_TRIGGER_PAIRS=0

# The comparison bot publishes nothing to HuggingFace.
BABBLE_HF_PUBLISH_EVERY=0
BABBLE_HF_PUBLISH_EVERY_ROWS=0
BABBLE_HF_PUBLISH_EVERY_CHARS=0

# Optional: Discord webhook for the collection feed. Unset = feed disabled.
# BABBLE_LOG_WEBHOOK_URL=
