# Fires babble-update.service on a wall-clock schedule. Change OnCalendar=
# (and reload) to adjust the check frequency -- a few minutes is plenty,
# since the service itself is a fast no-op whenever origin/main hasn't moved.
#
# OnCalendar= is used instead of OnUnitActiveSec= because OnUnitActiveSec=
# re-arms relative to the *timer unit's own last activation* -- with no
# OnCalendar= present, that activation never happens again after the initial
# OnBootSec= shot, so the timer goes "elapsed" and silently stops firing
# forever. OnCalendar= has no such dependency: systemd computes the next
# elapse from the wall clock every time, so it keeps firing indefinitely no
# matter when the timer was enabled relative to boot. OnBootSec= adds a
# quick post-boot check (a fresh boot has no prior wall-clock elapse to
# recover from) without affecting the recurring schedule, and
# Persistent=true covers the box being off across a scheduled tick, by
# firing once on the next start to make up for it.
[Unit]
Description=Periodic check: is the babble live install current with origin/main?

[Timer]
OnBootSec=2min
OnCalendar=*:0/5
Persistent=true
Unit=babble-update.service

[Install]
WantedBy=timers.target
