# Copy to .env and fill in. Nothing here is required to run the trainer, the
# tests, or the export -- only `babble bot` needs the token.

# From https://discord.com/developers/applications -> your app -> Bot -> Reset Token.
# The bot needs the MESSAGE CONTENT privileged intent enabled on that same page.
BABBLE_DISCORD_TOKEN=

# Salt for pseudonymising author ids in the published dataset.
# Leave unset and one is generated once into data/.salt and reused forever.
# If you set it, NEVER change it: the hashes are how `!babble forget` finds rows.
BABBLE_HASH_SALT=

# Where state lives (defaults are relative to the repo root).
# BABBLE_DATA_DIR=data
# BABBLE_CHECKPOINT_DIR=checkpoints
# BABBLE_EXPORT_DIR=export

# How rude the trainer is allowed to be to the rest of your machine.
# BABBLE_TRAIN_THREADS=2
# BABBLE_TRAIN_NICE=19
# BABBLE_CHECKPOINT_EVERY=50

# Pretraining: random init, on the consented human corpus, nothing else --
# there is no external corpus and no frozen base to continue from. BABBLE_TRAIN_STEPS
# is a ceiling, not a target: the run keeps whichever checkpoint had the lowest
# val loss and stops early once BABBLE_TRAIN_PATIENCE checkpoint intervals in a
# row fail to improve on it (0 = never stop early). It fires on a trigger, not a
# loop: every BABBLE_TRAIN_TRIGGER_ROWS new corpus rows since the last run
# (persisted in checkpoints/train_state.json, so a restart never re-fires), or
# on demand with `babble train --force`. 0 turns the automatic trigger off.
# BABBLE_TRAIN_STEPS=400
# BABBLE_TRAIN_PATIENCE=3
# BABBLE_TRAIN_TRIGGER_ROWS=100

# Sampling. Temperature was 1.0 and that was the single biggest reason a model
# with a good-looking loss still answered "hi" with character soup: at 1.0 the
# sampler faithfully acts on whatever uncertainty is left, and a byte-level
# model has no way back once one unlucky byte puts it off the memorised path.
# See "Why it babbled at loss 0.02" in the README for the measurement.
# BABBLE_TEMPERATURE=0.5
# BABBLE_TOP_K=40
# BABBLE_MAX_NEW_TOKENS=256

# Model geometry. block_size is the context window in bytes; raising it grows the
# learned positional-embedding table, so a change INVALIDATES every checkpoint
# trained at the old size -- the next `babble train` starts from random init
# anyway, so it just needs a run to produce a checkpoint at the new size again.
# BABBLE_BLOCK_SIZE=512

# Best-of-n: draw this many candidates and keep whichever one the model itself
# scores best (lowest mean per-byte loss). A derailed candidate scores terribly
# under the model that derailed it, so this quietly discards the bad draws. Set
# to 1 to turn it off and ship the first sample.
# BABBLE_BEST_OF=4

# Legacy, and read by nothing at all -- not by the trainer, and not written onto
# any stored row either. It used to multiply a correction row's stored weight at
# training time; the objective is now plain next-token prediction over the
# unlabelled corpus, where every row counts the same and there is no "chosen"
# answer to weight, so the code that read it is gone. Kept documented only so an
# existing .env that sets it is not a mystery; delete it whenever.
# BABBLE_CORRECTION_BOOST=3.0

# There is deliberately NO setting for collecting a whole channel. Widening
# collection past "messages addressed to the bot" is a consent decision each
# person makes for themselves, in one channel at a time, with `!babble all` --
# not something a deployment can switch on for everybody at once.

# Held-out validation: a stable hash of each corpus row's id decides which side of
# the split it's on, so the same row is always held out (or never is) no
# matter how the corpus grows or the trainer restarts. Below
# BABBLE_VAL_MIN_ROWS, holding out BABBLE_VAL_FRACTION of a handful of rows
# could starve training, so validation is skipped and reported as disabled
# instead of printing a meaningless number.
# BABBLE_VAL_FRACTION=0.2
# BABBLE_VAL_MIN_ROWS=20

# Where `babble export --push` -- and the trainer's auto-publish, below --
# send the dataset.
# BABBLE_HF_REPO=kowo-co/babble-corrections
# HF_TOKEN=

# Auto-publish, keyed to corpus GROWTH. In the collection phase there is no
# trainer and so no checkpoints, so the bot publishes when the corpus has grown
# by this-many rows OR this-many characters since the last publish (whichever
# comes first), through the same consent and blocklist guards as a manual
# `babble export --push`. The size at the last publish is persisted in
# data/publish_state.json, so a restart neither loses it nor re-publishes on
# boot. A push that fails (no HF_TOKEN, network, rate limit, HF down) is logged
# and reported in the collection feed but never stops capture. Set both to 0 to
# publish by hand only.
# BABBLE_HF_PUBLISH_EVERY_ROWS=10
# BABBLE_HF_PUBLISH_EVERY_CHARS=2000

# Auto-publish, keyed to training CHECKPOINTS. Only fires while `babble train`
# is actually running, which is why the growth-keyed publish above exists for
# the collection phase. Every this-many checkpoints written (not steps), the
# trainer builds the export and pushes it, same guards. Set to 0 to turn it off.
# BABBLE_HF_PUBLISH_EVERY=20

# Feed webhook, shared by the collection feed and the training feed. While no
# trainer runs (the collection phase), the channel reports collection: rows
# arriving, consent changes, growth milestones, and dataset publishes. When a
# trainer runs, it posts training progress here too. Unset means silent -- no
# channel, no posting, no change in
# behaviour. Create a webhook on the target channel (Discord: Edit Channel ->
# Integrations -> Webhooks -> New Webhook -> Copy Webhook URL) and put it here.
# For this deployment the target channel is <#1537688090217418773>.
# BABBLE_LOG_WEBHOOK_URL=
# Post only every Nth checkpoint, to keep a long run from flooding the channel.
# BABBLE_LOG_EVERY_N=1

# Content blocklist: rows where a corpus message, the prompt, the correction, or
# the model's own output match a blocked term are rejected outright -- never
# stored, trained on, or published. A small starter list ships in
# babble/blocklist.txt; point this at your own file to replace it (one term per
# line, # for comments).
# BABBLE_BLOCKLIST_PATH=
