# Copy to .env and fill in. Nothing here is required to run the trainer, the
# tests, or the export -- only `babble bot` needs the token.

# From https://discord.com/developers/applications -> your app -> Bot -> Reset Token.
# The bot needs the MESSAGE CONTENT privileged intent enabled on that same page.
BABBLE_DISCORD_TOKEN=

# Salt for pseudonymising author ids in the published dataset.
# Leave unset and one is generated once into data/.salt and reused forever.
# If you set it, NEVER change it: the hashes are how `!babble forget` finds rows.
BABBLE_HASH_SALT=

# Where state lives (defaults are relative to the repo root).
# BABBLE_DATA_DIR=data
# BABBLE_CHECKPOINT_DIR=checkpoints
# BABBLE_EXPORT_DIR=export

# How rude the trainer is allowed to be to the rest of your machine.
# BABBLE_TRAIN_THREADS=2
# BABBLE_TRAIN_NICE=19
# BABBLE_STEPS_PER_CYCLE=200
# BABBLE_CHECKPOINT_EVERY=50
# BABBLE_REST_SECONDS=60

# Where `babble export --push` sends the dataset.
# BABBLE_HF_REPO=kowo-co/babble-corrections
# HF_TOKEN=
